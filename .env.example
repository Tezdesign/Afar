EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Supabase (public: safe in the app bundle)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# The Clerk webhook runs in Supabase (supabase/functions/clerk-webhook). Its signing secret is a
# Supabase secret, set with `supabase secrets set CLERK_WEBHOOK_SIGNING_SECRET=whsec_...`, not here.

# SerpApi live flight prices (spec 0003). Server only: never add the EXPO_PUBLIC_ prefix.
# Without a key, /api/flights answers a "not_configured" fallback and Results keeps sample data.
SERPAPI_API_KEY=your_serpapi_key_here
# Optional caps (defaults shown). The free plan is 250 searches a month.
SERPAPI_MONTHLY_CAP=200
SERPAPI_DEVICE_DAILY_CAP=10
SERPAPI_GLOBAL_PER_MINUTE=5
